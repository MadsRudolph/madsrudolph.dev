---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { coursework, courseUrl, ectsOf } from '../data/courses';

const projects = await getCollection('projects');
const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const cw = coursework.en;

const tools = [
  { name: 'KiCad', use: 'Schematic and PCB layout', icon: 'M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3M6 6h12v12H6zM9 9h6v6H9z' },
  { name: 'Roland SRM-20 + SRM-CAM', use: 'PCB milling, my own CAM', icon: 'M12 3v4M8 7h8l-1 4H9zM12 11v10M7 21h10' },
  { name: 'xTool F1 Ultra', use: 'Fiber-laser etching', icon: 'M13 2 4 14h6l-1 8 9-12h-6z' },
  { name: 'ESP-IDF / AVR', use: 'Firmware in C and C++', icon: 'm16 18 6-6-6-6M8 6l-6 6 6 6' },
  { name: 'Python', use: 'Tooling and desktop apps', icon: 'M4 17V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM8 9l3 3-3 3M13 15h4' },
  { name: 'Scope & logic analyzer', use: 'Bench verification', icon: 'M2 12h4l3-8 4 16 3-8h6' },
  { name: 'KiCad ngspice / LTspice', use: 'Circuit simulation', icon: 'M3 20h18M5 16l4-6 3 4 4-8 3 5' },
  { name: 'Fusion 360 / Blender', use: 'Enclosures and CAD', icon: 'M12 2 3 7v10l9 5 9-5V7zM12 12 3 7M12 12l9-5M12 12v10' },
  { name: 'Claude Code', use: 'AI-assisted, test-driven builds', icon: 'M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z' },
];
---

<Base
  title="Mads Rudolph — electronics engineering student, DTU"
  description="Portfolio of Mads Rudolph: PCB design, embedded firmware, and electronics debugging. Seeking an engineering internship (praktik) from January 2027."
  lang="en"
  altUrl="/da"
>
  <section class="hero hero-compact">
    <img class="portrait" src="/media/mads-rudolph.jpg" alt="Mads Rudolph" width="260" height="325" />
    <div class="hero-copy">
      <h1>Mads Rudolph</h1>
      <p class="intro">Electrical engineering student at DTU. I build and debug audio hardware, PCBs, and embedded systems.</p>
      <p class="availability">Available for praktik from January 2027.</p>
      <div class="actions">
        <a href="#work" class="btn primary">See my work</a>
        <a href="mailto:mads28122001@hotmail.dk" class="btn secondary">Email me</a>
      </div>
    </div>
  </section>

  <section class="home-section" id="work">
    <h2 class="display"><span>Selected</span><span class="dim">projects</span></h2>
    <ul class="project-list">
      {featured.map((project, i) => <ProjectCard project={project} index={i} image />)}
    </ul>
    <p class="more"><a class="btn secondary" href="/projects">All {projects.length} projects</a></p>
  </section>

  <div class="focus">
    <a class="focus-card orange" href="/projects#pcb">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2 2 7l10 5 10-5zM2 12l10 5 10-5M2 17l10 5 10-5" />
      </svg>
      <h3>PCB design & fabrication</h3>
      <p>KiCad to milled board, on my own bench.</p>
      <span class="arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
      </span>
    </a>
    <a class="focus-card lime" href="/projects#audio">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 12h3l3-7 4 14 3-9 2 4h5" />
      </svg>
      <h3>Audio & analog design</h3>
      <p>A discrete delta-sigma ADC and a sub crossover, measured on the bench.</p>
      <span class="arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
      </span>
    </a>
  </div>



  <section class="home-section" id="tools">
    <h2 class="display"><span>Bench &amp;</span><span class="dim">toolchain</span></h2>
    <ul class="tools">
      {
        tools.map((t) => (
          <li>
            <span class="glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon} /></svg>
            </span>
            <span>
              <span class="name">{t.name}</span>
              <span class="use">{t.use}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="home-section" id="semester">
    <h2 class="display"><span>This</span><span class="dim">semester</span></h2>
    <div class="terms">
      <section class="term current">
        <h3 class="term-head">{cw.current.term} <span class="sem">{cw.current.sem} · {ectsOf([cw.current])} ECTS</span></h3>
        <ul class="course-list">
          {
            cw.current.courses.map((c) => (
              <li>
                <a class="code" href={courseUrl(c.code)} target="_blank" rel="noopener">{c.code}</a>
                <span class="ctitle">{c.title}</span>
                <span class="ects">{c.ects}</span>
              </li>
            ))
          }
        </ul>
        {cw.current.note && <p class="note">{cw.current.note}</p>}
      </section>
    </div>
    <p class="more"><a class="btn secondary" href="/courses">All coursework</a></p>
  </section>

  <section class="home-section contact" id="contact">
    <h2 class="display"><span>Let's work</span><span class="dim">together</span></h2>
    <p>Praktik from January 2027, student jobs before then. Danish or English.</p>
    <a href="mailto:mads28122001@hotmail.dk" class="btn primary">mads28122001@hotmail.dk</a>
    <div class="links">
      <a href="https://github.com/MadsRudolph">GitHub</a>
      <a href="https://www.linkedin.com/in/mads-rudolph-65103a178/">LinkedIn</a>
      <a href="/cv">CV</a>
    </div>
  </section>
</Base>
