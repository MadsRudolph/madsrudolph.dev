---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = await getCollection('projects');
const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Base
  title="Mads Rudolph — electronics engineering student, DTU"
  description="Portfolio of Mads Rudolph: PCB design, embedded firmware, and electronics debugging. Seeking an engineering internship (praktik) from January 2027."
  lang="en"
  altUrl="/da"
  wide
>
  <section class="hero">
    <p class="label eyebrow">Electrical engineering · DTU · Copenhagen</p>
    <h1>I build and debug real hardware<span class="accent">.</span></h1>
    <p class="lede">
      PCB design and fabrication, embedded firmware, and bench debugging. Every project here is
      written up the same way: what it is, how it's built, what went wrong, and how I found out.
    </p>
    <div class="hero-actions">
      <a href="/projects" class="btn primary">See the work</a>
      <a href="mailto:mads28122001@hotmail.dk" class="btn secondary">Email me</a>
      <a href="/cv" class="btn text">Read the CV →</a>
    </div>

    <dl class="facts">
      <div>
        <dt>Looking for</dt>
        <dd>Praktik from Jan 2027<small>and student jobs alongside</small></dd>
      </div>
      <div>
        <dt>Studying</dt>
        <dd>B.Eng. Elektroteknologi<small>DTU · 5th semester · 110 ECTS</small></dd>
      </div>
      <div>
        <dt>Best at</dt>
        <dd>Hardware troubleshooting<small>finding out why it doesn't work</small></dd>
      </div>
      <div>
        <dt>Direction</dt>
        <dd>Audio &amp; analog hardware<small>DSP, electroacoustics, mixed-signal</small></dd>
      </div>
    </dl>

    <p class="dansk" lang="da">
      Jeg er diplomingeniørstuderende i Elektroteknologi på DTU og søger praktikplads fra januar
      2027 samt studiejob inden for elektronik og embedded udvikling. Skriv gerne på engelsk eller
      dansk.
    </p>
  </section>

  <div class="section-head">
    <h2>Selected work<span class="count">{String(featured.length).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</span></h2>
    <a href="/projects">All {projects.length} projects →</a>
  </div>
  <ul class="project-list grid">
    {featured.map((project, i) => <ProjectCard project={project} index={i} image />)}
  </ul>

  <div class="section-head">
    <h2>What I do</h2>
  </div>
  <div class="skills-matrix">
    <div class="skill-category">
      <h3>Hardware &amp; PCBs</h3>
      <ul>
        <li>KiCad schematic and layout</li>
        <li>Fiber-laser and CNC fabrication</li>
        <li>Analog and digital circuits</li>
        <li>Power electronics</li>
      </ul>
    </div>
    <div class="skill-category">
      <h3>Firmware &amp; software</h3>
      <ul>
        <li>C / C++ on ESP32 and AVR</li>
        <li>Python tooling and desktop apps</li>
        <li>Digital signal processing</li>
        <li>Test-driven, AI-assisted development</li>
      </ul>
    </div>
    <div class="skill-category">
      <h3>Bench &amp; debugging</h3>
      <ul>
        <li>Oscilloscope and logic analyzer</li>
        <li>Protocol reverse engineering</li>
        <li>Hardware / firmware integration</li>
        <li>Failure diagnosis, written down</li>
      </ul>
    </div>
  </div>

  <div class="section-head">
    <h2>Contact</h2>
  </div>
  <div class="contact-block">
    <a class="big" href="mailto:mads28122001@hotmail.dk">mads28122001@hotmail.dk</a>
    <div class="links">
      <a href="https://github.com/MadsRudolph">GitHub</a>
      <a href="https://www.linkedin.com/in/mads-rudolph-65103a178/">LinkedIn</a>
      <span class="label">Kgs. Lyngby, Denmark</span>
    </div>
  </div>
</Base>
