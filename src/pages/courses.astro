---
import Base from '../layouts/Base.astro';
import { coursework, courseUrl, ectsOf } from '../data/courses';
import type { Term } from '../data/courses';

const cw = coursework.en;
const totalCompleted = ectsOf(cw.completed);

const blocks: { title: string; terms: Term[]; current?: boolean }[] = [
  { title: 'Now', terms: [cw.current], current: true },
  { title: 'Completed', terms: cw.completed },
  { title: 'Planned', terms: cw.planned },
];
---

<Base
  title="Courses — Mads Rudolph"
  description={`DTU coursework — ${totalCompleted} ECTS completed toward a B.Eng. in Electrical Engineering, the current semester, and the plan through the bachelor thesis.`}
  lang="en"
  altUrl="/da/courses"
>
  <div class="page-head">
    <h1>Course<br />work</h1>
    <p class="lede">
      The B.Eng. in Electrical Engineering (Elektroteknologi) at DTU: {totalCompleted} ECTS completed,
      this semester in progress, and the plan through the thesis. Grades are omitted; the full
      transcript is available on request.
    </p>
  </div>

  {
    blocks.map((b) => (
      <section class="home-section">
        <h2 class="display"><span class="dim">{b.title}</span></h2>
        {b.title === 'Planned' && (
          <p class="term-summary">
            The elective track builds toward analog and mixed-signal electronics, power electronics
            (switch-mode, class-D) and electroacoustics — an audio-hardware focus on top of the
            embedded base. Internship in spring 2027, bachelor thesis in autumn 2027.
          </p>
        )}
        <div class="terms">
          {b.terms.map((t) => (
            <section class:list={['term', { current: b.current }]}>
              <h3 class="term-head">
                {t.term} <span class="sem">{t.sem} · {ectsOf([t])} ECTS</span>
              </h3>
              <ul class="course-list">
                {t.courses.map((c) => (
                  <li>
                    {courseUrl(c.code) ? (
                      <a class="code" href={courseUrl(c.code)} target="_blank" rel="noopener">{c.code}</a>
                    ) : (
                      <span class="code">{c.code}</span>
                    )}
                    <span class="ctitle">{c.title}</span>
                    <span class="ects">{c.ects}</span>
                  </li>
                ))}
              </ul>
              {t.note && <p class="note">{t.note}</p>}
            </section>
          ))}
        </div>
      </section>
    ))
  }
</Base>
