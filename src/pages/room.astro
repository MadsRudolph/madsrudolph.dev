---
import '@fontsource-variable/inter';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Explore Mads’s furnished dorm room in interactive 3D."/><title>The room — Mads Rudolph</title><link rel="icon" href="/favicon.svg"/></head>
<body>
<div id="viewport" aria-label="Interactive 3D room. Drag to rotate, scroll to zoom."></div>
<header><a href="/" class="brand">MR<span> / SPACES</span></a><span class="live"><i></i> INTERACTIVE 3D</span></header>
<section class="intro"><p class="eyebrow">A SMALL SPACE, MADE PERSONAL</p><h1>The room<span>.</span></h1><p>Study. Make. Listen. Unwind.</p></section>
<div id="loading" role="status"><span class="spinner"></span><span id="load-text">Preparing your room…</span></div>
<aside><span class="eyebrow">YOUR PERSPECTIVE</span><nav aria-label="Room viewpoints"><button data-view="overview" class="active">01 <span>Overview</span> ↗</button><button data-view="inside">02 <span>Step inside</span> ↗</button><button data-view="bed">03 <span>From the bed</span> ↗</button><button data-view="desk">04 <span>At the desk</span> ↗</button><button data-view="speakers">05 <span>The surrounds</span> ↗</button></nav><div class="options"><label><input type="checkbox" id="open-room" checked/> Open walls & ceiling</label><label><input type="checkbox" id="evening"/> Evening light</label></div><button id="fly">Explore freely <span>⌘</span></button><button id="fullscreen">Full screen <span>⛶</span></button></aside>
<footer><div><span class="dot"></span><span id="hint">Drag to orbit · Scroll to zoom · Right-drag to pan</span></div><span class="scale">2.55 × 4.40 M <span>/</span> DORM ROOM</span></footer>
<div id="movement" hidden><button data-key="KeyQ" aria-label="Move down">↓</button><button data-key="KeyW" aria-label="Move forward">Forward</button><button data-key="KeyE" aria-label="Move up">↑</button><button data-key="KeyA" aria-label="Move left">Left</button><button data-key="KeyS" aria-label="Move backward">Back</button><button data-key="KeyD" aria-label="Move right">Right</button></div>
<script>import '../scripts/room';</script>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#e9e5dc;color:#272c29;font-family:'Inter Variable',sans-serif;font-size:13px;overflow:hidden}button,a,input{-webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer;color:inherit}button:focus-visible,a:focus-visible{outline:2px solid #a75231;outline-offset:4px}#viewport{position:fixed;inset:0}canvas{display:block;touch-action:none}header{position:absolute;top:32px;left:38px;right:38px;display:flex;justify-content:space-between;pointer-events:none}.brand{pointer-events:auto;text-decoration:none;color:inherit;font-weight:750;letter-spacing:-1px;font-size:24px}.brand span{font-size:10px;letter-spacing:2px;font-weight:500;margin-left:12px}.live,.eyebrow{font-size:9px;letter-spacing:2px;font-weight:650}.live{display:flex;align-items:center;gap:9px}.live i,.dot{height:6px;width:6px;border-radius:50%;background:#6f8069;display:inline-block}.intro{position:absolute;top:119px;left:38px;pointer-events:none}.eyebrow{color:#777b72}.intro h1{font-size:clamp(40px,5vw,72px);letter-spacing:-4px;font-weight:500;margin:16px 0 12px;line-height:1}.intro h1 span{color:#a75231}.intro>p:last-child{color:#747870;font-size:12px}aside{position:absolute;right:32px;top:50%;transform:translateY(-45%);width:216px;background:#f9f8f1e8;backdrop-filter:blur(18px);border:1px solid #fff9;padding:24px 20px;border-radius:3px;box-shadow:0 12px 50px #363b3510}nav{margin:18px 0}nav button{display:flex;align-items:center;width:100%;gap:12px;padding:13px 0;border:0;border-bottom:1px solid #ddddcf;background:none;font-size:10px;color:#8b8d80}nav button span{flex:1;text-align:left;font-size:12px;color:#55594f}nav button.active,nav button.active span{color:#a75231}nav button.active span{font-weight:650}.options{display:grid;gap:14px;padding:0 0 20px;font-size:11px}label{display:flex;align-items:center;gap:7px}input{accent-color:#596b58}#fly,#fullscreen{display:flex;justify-content:space-between;width:100%;border:0;padding:12px;background:#303c32;color:#fff;border-radius:2px;font-size:11px}#fullscreen{background:transparent;color:#616759;padding-bottom:0}footer{position:absolute;bottom:28px;left:38px;right:38px;display:flex;justify-content:space-between;font-size:10px;color:#666e61;pointer-events:none}footer>div{display:flex;gap:10px;align-items:center}.scale{letter-spacing:1.3px}.scale span{margin:0 12px;color:#a2a697}#loading{position:absolute;inset:0;background:#e9e5dc;display:flex;align-items:center;justify-content:center;gap:14px;z-index:10;font-size:13px}#loading[hidden]{display:none}.spinner{width:20px;height:20px;border:2px solid #b3b8a9;border-top-color:#3c4b3b;border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}#movement{position:absolute;bottom:70px;left:38px;display:grid;grid-template-columns:repeat(3,64px);gap:5px}#movement[hidden]{display:none}#movement button{background:#f8f7f0dd;border:1px solid #c5cbbb;padding:14px 3px;border-radius:3px;touch-action:none;font-size:10px}body.flying .intro,body.interior .intro{display:none} @media(max-width:700px){header{top:22px;left:22px;right:22px}.live{font-size:8px;letter-spacing:1px}.intro{top:80px;left:22px}.intro h1{letter-spacing:-2px;margin:12px 0}.intro .eyebrow{font-size:8px}aside{top:auto;bottom:54px;left:14px;right:14px;transform:none;width:auto;padding:13px 14px}.eyebrow,aside>.eyebrow{display:none}nav{display:flex;gap:7px;margin:0 0 12px}nav button{padding:9px 2px;font-size:0;gap:0;justify-content:center}nav button span{font-size:10px;text-align:center}.options{display:flex;justify-content:space-between;padding-bottom:12px;font-size:10px}#fly,#fullscreen{width:49%;display:inline-flex;padding:10px}footer{left:20px;right:20px;bottom:20px;font-size:9px}.scale{display:none}#movement{bottom:253px;left:20px}body.flying aside{opacity:.92}}
</style></body></html>
