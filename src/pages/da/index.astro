---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = await getCollection('projects');
const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Base
  title="Mads Rudolph — elektroteknologistuderende, DTU"
  description="Portfolio for Mads Rudolph: PCB-design, embedded firmware og fejlfinding på elektronik. Søger ingeniørpraktik fra januar 2027."
  lang="da"
  altUrl="/"
  wide
>
  <section class="hero">
    <p class="label eyebrow">Elektroteknologi · DTU · København</p>
    <h1>Jeg bygger og fejlfinder rigtig hardware<span class="accent">.</span></h1>
    <p class="lede">
      PCB-design og -fremstilling, embedded firmware og fejlfinding på bænken. Hvert projekt er
      beskrevet på samme måde: hvad det er, hvordan det er bygget, hvad der gik galt, og hvordan
      jeg fandt fejlen.
    </p>
    <div class="hero-actions">
      <a href="/da/projects" class="btn primary">Se projekterne</a>
      <a href="mailto:mads28122001@hotmail.dk" class="btn secondary">Skriv til mig</a>
      <a href="/da/cv" class="btn text">Læs CV'et →</a>
    </div>

    <dl class="facts">
      <div>
        <dt>Søger</dt>
        <dd>Praktik fra jan. 2027<small>og studiejob ved siden af</small></dd>
      </div>
      <div>
        <dt>Studerer</dt>
        <dd>Diplomingeniør, Elektroteknologi<small>DTU · 5. semester · 110 ECTS</small></dd>
      </div>
      <div>
        <dt>Bedst til</dt>
        <dd>Fejlfinding på hardware<small>at finde ud af, hvorfor det ikke virker</small></dd>
      </div>
      <div>
        <dt>Retning</dt>
        <dd>Audio- og analog hardware<small>DSP, elektroakustik, mixed-signal</small></dd>
      </div>
    </dl>

    <p class="dansk" lang="en">
      Project write-ups are in English. The rest of the site is available in both languages.
    </p>
  </section>

  <div class="section-head">
    <h2>Udvalgte projekter<span class="count">{String(featured.length).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</span></h2>
    <a href="/da/projects">Alle {projects.length} projekter →</a>
  </div>
  <ul class="project-list grid">
    {featured.map((project, i) => <ProjectCard project={project} index={i} lang="da" image />)}
  </ul>

  <div class="section-head">
    <h2>Det jeg laver</h2>
  </div>
  <div class="skills-matrix">
    <div class="skill-category">
      <h3>Hardware &amp; print</h3>
      <ul>
        <li>KiCad skema og layout</li>
        <li>Fiberlaser- og CNC-fremstilling</li>
        <li>Analoge og digitale kredsløb</li>
        <li>Effektelektronik</li>
      </ul>
    </div>
    <div class="skill-category">
      <h3>Firmware &amp; software</h3>
      <ul>
        <li>C / C++ på ESP32 og AVR</li>
        <li>Python-værktøj og desktop-apps</li>
        <li>Digital signalbehandling</li>
        <li>Testdrevet, AI-assisteret udvikling</li>
      </ul>
    </div>
    <div class="skill-category">
      <h3>Bænk &amp; fejlfinding</h3>
      <ul>
        <li>Oscilloskop og logikanalysator</li>
        <li>Reverse engineering af protokoller</li>
        <li>Hardware/firmware-integration</li>
        <li>Fejldiagnose, skrevet ned</li>
      </ul>
    </div>
  </div>

  <div class="section-head">
    <h2>Kontakt</h2>
  </div>
  <div class="contact-block">
    <a class="big" href="mailto:mads28122001@hotmail.dk">mads28122001@hotmail.dk</a>
    <div class="links">
      <a href="https://github.com/MadsRudolph">GitHub</a>
      <a href="https://www.linkedin.com/in/mads-rudolph-65103a178/">LinkedIn</a>
      <span class="label">Kgs. Lyngby, Danmark</span>
    </div>
  </div>
</Base>
