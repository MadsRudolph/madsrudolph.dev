---
import Base from '../../layouts/Base.astro';
import { coursework, courseUrl, ectsOf } from '../../data/courses';
import type { Term } from '../../data/courses';

const cw = coursework.da;
const totalCompleted = ectsOf(cw.completed);

const blocks: { title: string; terms: Term[]; current?: boolean }[] = [
  { title: 'Nu', terms: [cw.current], current: true },
  { title: 'Gennemført', terms: cw.completed },
  { title: 'Planlagt', terms: cw.planned },
];
---

<Base
  title="Kurser — Mads Rudolph"
  description={`DTU-kurser — ${totalCompleted} ECTS gennemført mod diplomingeniør i Elektroteknologi, det nuværende semester og planen frem til bachelorprojektet.`}
  lang="da"
  altUrl="/courses"
>
  <div class="page-head">
    <h1>Kurser</h1>
    <p class="lede">
      Diplomingeniør i Elektroteknologi på DTU: {totalCompleted} ECTS gennemført, dette semester i gang,
      og planen frem til projektet. Karakterer er udeladt; den fulde karakteroversigt kan fås på
      forespørgsel.
    </p>
  </div>

  {
    blocks.map((b) => (
      <section class="home-section">
        <h2 class="display"><span class="dim">{b.title}</span></h2>
        {b.title === 'Planlagt' && (
          <p class="term-summary">
            Valgfagssporet bygger mod analog og mixed-signal elektronik, effektelektronik
            (switch-mode, klasse D) og elektroakustik — et audio-hardware-fokus oven på den
            embedded base. Praktik i foråret 2027, bachelorprojekt i efteråret 2027.
          </p>
        )}
        <div class="terms">
          {b.terms.map((t) => (
            <section class:list={['term', { current: b.current }]}>
              <h3 class="term-head">
                {t.term} <span class="sem">{t.sem} · {ectsOf([t])} ECTS</span>
              </h3>
              <ul class="course-list">
                {t.courses.map((c) => (
                  <li>
                    {courseUrl(c.code) ? (
                      <a class="code" href={courseUrl(c.code)} target="_blank" rel="noopener">{c.code}</a>
                    ) : (
                      <span class="code">{c.code}</span>
                    )}
                    <span class="ctitle">{c.title}</span>
                    <span class="ects">{c.ects}</span>
                  </li>
                ))}
              </ul>
              {t.note && <p class="note">{t.note}</p>}
            </section>
          ))}
        </div>
      </section>
    ))
  }
</Base>
