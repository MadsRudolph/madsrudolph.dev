---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  lang?: Lang;
  /** Display a larger image above the project description. */
  image?: boolean;
  /** Values put in data-tags for the index filter (broad categories). Defaults to the raw tags. */
  filterTags?: string[];
}

const { project, index, image = false, lang = 'en', filterTags } = Astro.props;
const { title, summary, date, tags, status, flagship, hero, heroAlt } = project.data;
const dataTags = (filterTags ?? tags).join(',');

const flagshipLabel = lang === 'da' ? 'flagskib' : 'flagship';

const locale = lang === 'da' ? 'da-DK' : 'en-GB';
const dateLabel = date.toLocaleDateString(locale, { year: 'numeric', month: 'short' });

const statusLabels = {
  en: { working: 'working', 'in-progress': 'in progress', archived: 'archived' },
  da: { working: 'fungerer', 'in-progress': 'i gang', archived: 'arkiveret' },
};
const statusLabel = statusLabels[lang][status];

// Write-ups are English-only, so cards always link to the English page.
const href = `/projects/${project.id}`;
const initial = title.replace(/^[^A-Za-z0-9]+/, '').charAt(0).toUpperCase();
void index;
---

<li class:list={['project-card', { flagship, visual: image && !!hero }]} data-tags={dataTags}>
  {
    hero ? (
      <a class="card-thumb" href={href} tabindex="-1" aria-hidden="true">
        <img src={hero} alt={heroAlt ?? ''} loading="lazy" width={image ? 960 : 96} height={image ? 640 : 96} />
      </a>
    ) : (
      <span class="card-thumb placeholder" aria-hidden="true">{initial}</span>
    )
  }
  <div class="body">
    <div class="meta">
      {flagship && <span class="flag">{flagshipLabel}</span>}
      <span>{dateLabel}</span>
      <span class="status" data-status={status}>
        <span class="led" aria-hidden="true"></span>
        {statusLabel}
      </span>
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p>{summary}</p>
    <div class="tags">
      {tags.slice(0, 5).map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
  <svg class="go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 17 17 7M8 7h9v9" />
  </svg>
</li>
